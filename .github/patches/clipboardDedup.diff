+// Nextec: assinatura do conteudo ignorando so o marcador de dono (os demais formatos, como
+// "XML Spreadsheet", entram na assinatura).
+#[cfg(not(target_os = "android"))]
+fn nextec_signature(items: &[Clipboard]) -> Option<u64> {
+    let mut sig = crate::nextec_clipboard_dedup::Assinatura::novo();
+    for c in items {
+        sig.item(
+            c.format.value(),
+            c.compress,
+            c.width,
+            c.height,
+            &c.special_name,
+            &c.content[..],
+        );
+    }
+    sig.fim()
+}
+
 #[cfg(not(target_os = "android"))]
 pub fn update_clipboard(multi_clipboards: Vec<Clipboard>, side: ClipboardSide) {
+    // Nextec: o host devolve de 3 a 5 vezes o que o cliente acabou de enviar; cada regravacao vira uma
+    // entrada nova no historico do Windows (Win+V). Eco ja enviado ou ja aplicado nao e regravado.
+    let nextec_sig = if side == ClipboardSide::Client {
+        nextec_signature(&multi_clipboards)
+    } else {
+        None
+    };
+    if let Some(sig) = nextec_sig {
+        if !crate::nextec_clipboard_dedup::deve_aplicar(sig) {
+            log::debug!(
+                "{} update on {} ignored, same content as the last one",
+                CLIPBOARD_NAME,
+                side
+            );
+            return;
+        }
+    }
     std::thread::spawn(move || {
-        update_clipboard_(multi_clipboards, side);
+        // Se a gravacao falhar, o conteudo nao conta como aplicado: a proxima entrega igual e tentada.
+        if !update_clipboard_(multi_clipboards, side) {
+            if let Some(sig) = nextec_sig {
+                crate::nextec_clipboard_dedup::falhou(sig);
+            }
+        }
     });
 }
 
