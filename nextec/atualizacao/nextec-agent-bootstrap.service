[Unit]
Description=Nextec Connect agent bootstrap coordinator
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
StateDirectory=nextec-connect
StateDirectoryMode=0755
ExecStart=/usr/bin/python3 /usr/lib/nextec-connect/coordenador-agente-nextec-linux.py
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# O discovery via --get-id precisa compartilhar o IPC RustDesk em /tmp.
PrivateTmp=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/nextec-connect
UMask=0077
